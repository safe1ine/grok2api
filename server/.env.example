# 服务端口
PORT=30081

# PostgreSQL 连接串
DATABASE_URL=postgres://grok2api:grok2api@localhost:5432/grok2api?sslmode=disable

# xAI OAuth 应用（去 https://console.x.ai 注册，redirect_uri 填 http://localhost:30081/api/oauth/callback）
XAI_CLIENT_ID=
# 公开客户端 + PKCE 时可不填 secret
XAI_CLIENT_SECRET=
XAI_SCOPE="openid profile email offline_access grok-cli:access api:access"
XAI_REDIRECT_URI="http://localhost:30081/api/oauth/callback"
XAI_AUTH_BASE="https://auth.x.ai"
XAI_API_BASE="https://api.x.ai"

# 管理台登录
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# refresh_token 加密密钥（重启后必须保持不变；留空则用 ADMIN_PASSWORD 派生）
ENCRYPTION_KEY=

# 可选：前端构建产物目录（生产部署时指向 web/dist；debug 时前端用 vite dev 30080 代理，无需设置）
WEB_DIST=
